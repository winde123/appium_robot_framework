t work performed by the former Customs &amp; Excise Department (CED)." resource-id="" class="android.widget.TextView" package="sg.gov.ica.mobile.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,544][1356,1806]" drawing-order="2" hint="" /></node></node></node></node></node></node></node></node></node><node index="1" text="" resource-id="" class="android.view.ViewGroup" package="sg.gov.ica.mobile.app" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1440,368]" drawing-order="2" hint="" /></node></node></node></node></node></node></node></node></node></node></hierarchy>